MOSAIC_ENVIRONMENT=local
MOSAIC_AUTH_MODE=local
MOSAIC_REPOSITORY_BACKEND=memory
MOSAIC_TENANT_ID=00000000-0000-0000-0000-000000000000
MOSAIC_CORS_ORIGINS=["http://localhost:5173"]

# Optional onboarding hint only. Gateways MOSAIC manages are records in Cosmos, not configuration.
# When set, the API offers this API Management service as a suggested gateway and seeds it once.
# MOSAIC_APIM_SUBSCRIPTION_ID=
# MOSAIC_APIM_RESOURCE_GROUP=
# MOSAIC_APIM_SERVICE_NAME=
