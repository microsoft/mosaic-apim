MOSAIC_ENVIRONMENT=local
MOSAIC_AUTH_MODE=local
MOSAIC_REPOSITORY_BACKEND=memory
MOSAIC_TENANT_ID=00000000-0000-0000-0000-000000000000
MOSAIC_CORS_ORIGINS=["http://localhost:5173"]

# Experimental, API-only managed cost-center groups; default off. This links one MOSAIC group
# to each new cost center and shares its existing membership roster. It does not enable
# inherited model access, synchronize APIM, create native keys, or write to Entra.
# MOSAIC_MANAGED_COST_CENTER_GROUPS=false

# Optional GUID audience for Entra-authenticated model calls through APIM. This is a separate
# single-tenant registration from MOSAIC_API_CLIENT_ID; it is never a control-plane audience.
# Delegated model clients request api://<runtime-client-id>/Models.Invoke with tenant admin
# consent, and delegated MCP clients request api://<runtime-client-id>/Mcp.Invoke. App-only clients
# need Models.Invoke.Application for models or Mcp.Invoke.Application for MCP, and request the
# runtime /.default scope. Consent does not grant runtime access: callers also need a MOSAIC grant.
# Leave unset for legacy/key-only deployments.
# MOSAIC_MODEL_RUNTIME_CLIENT_ID=

# Optional GUID of the public client people sign in with to get delegated model-runtime tokens
# (azd creates mosaic-<env>-model-client unless MOSAIC_ENTRA_MODEL_CLIENT=false). Connection
# details return it as entraClientId next to entraScope. Must differ from the API and
# model-runtime client IDs.
# MOSAIC_MODEL_CLIENT_ID=

# Optional onboarding hint only. Gateways MOSAIC manages are records in Cosmos, not configuration.
# When set, the API offers this API Management service as a suggested gateway and seeds it once.
# MOSAIC_APIM_SUBSCRIPTION_ID=
# MOSAIC_APIM_RESOURCE_GROUP=
# MOSAIC_APIM_SERVICE_NAME=

# Isolated commercial vault for external Azure management service-principal credentials.
# Never reuse MOSAIC_KEY_VAULT_URI: APIM can read that backend-credential vault.
# Only the MOSAIC API identity gets Secrets Officer on this separate vault. Existing commercial
# host-identity resources work without it; Settings > Azure connections requires it.
# MOSAIC_MANAGEMENT_KEY_VAULT_URI=https://your-management-vault.vault.azure.net

# How long MOSAIC waits on one call to a registered MCP server.
# MOSAIC_MCP_DISCOVERY_TIMEOUT_SECONDS=20

# Where usage figures come from: auto (the default), rollups, or simulated. auto reads rollups of
# the gateways' logs in Azure and simulates usage from your real grants everywhere else, labeled
# "Sample figures". rollups queries Log Analytics with your Azure CLI sign-in, which needs read
# access to the logs of the API Management services you register, such as Monitoring Reader.
# simulated is refused when MOSAIC_ENVIRONMENT=azure. See docs/usage-analytics.md.
# MOSAIC_USAGE_SOURCE=auto

# The rollup job copies gateway logs into the usage-rollups container. It runs only when usage
# comes from rollups. The interval is 60 to 86400 seconds. Retention is 62 to 3650 days of daily
# figures; monthly summaries are kept. The backfill is how many days a gateway's first rollup, a
# catch-up after downtime, or an admin's backfill without a day count reads back, from 1 to 730.
# MOSAIC_USAGE_ROLLUP_ENABLED=true
# MOSAIC_USAGE_ROLLUP_INTERVAL_SECONDS=900
# MOSAIC_USAGE_ROLLUP_RETENTION_DAYS=400
# MOSAIC_USAGE_ROLLUP_BACKFILL_MAX_DAYS=90

# Host-identity Log Analytics query endpoint. Registered external connections select their own
# cloud's endpoint; do not set this to Government just because one registered gateway is there.
# MOSAIC_LOG_ANALYTICS_ENDPOINT=https://api.loganalytics.azure.com

# Permit registering an MCP server on a loopback or private address. Local development only:
# startup rejects it when MOSAIC_ENVIRONMENT=azure, because it would let a managed-identity token
# reach the instance metadata service.
# MOSAIC_MCP_ALLOW_PRIVATE_ENDPOINTS=true
