{
  "environment": "mosaic-dev",
  "tenantId": "00000000-0000-0000-0000-000000000000",
  "origins": {
    "web": "https://mosaic-dev-web-example.azurewebsites.net",
    "portal": "https://mosaic-dev-portal-example.azurewebsites.net",
    "api": "https://mosaic-dev-api-example.azurewebsites.net",
    "gateway": "https://apim-mosaic-dev-example.azure-api.net"
  },
  "roles": {
    "admin": "admin",
    "user": "user-a",
    "guest": "guest",
    "noRole": "user-b",
    "outsider": "outsider"
  },
  "personas": {
    "admin": {
      "upn": "admin@contoso.example",
      "expectedRole": "Admin",
      "description": "Holds the MOSAIC Admin role; drives every console journey."
    },
    "user-a": {
      "upn": "user-a@contoso.example",
      "expectedRole": "User",
      "description": "Member user who is granted a model and calls it."
    },
    "user-b": {
      "upn": "user-b@contoso.example",
      "expectedRole": "None",
      "description": "Starts without a MOSAIC role to prove the portal withholds data, then requests access."
    },
    "guest": {
      "upn": "guest@fabrikam.example",
      "expectedRole": "User",
      "guest": true,
      "description": "B2B guest with the MOSAIC User role."
    },
    "outsider": {
      "upn": "outsider@contoso.example",
      "expectedRole": "None",
      "description": "Never granted anything; every runtime call must be denied."
    }
  },
  "workload": {
    "displayName": "mosaic-dev-e2e-workload",
    "objectId": "22222222-2222-2222-2222-222222222222"
  },
  "endpoints": {
    "aoai-east": {
      "kind": "azure-openai",
      "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-aoai/providers/Microsoft.CognitiveServices/accounts/aoai-east",
      "registerVia": "paste",
      "publish": ["gpt-4.1-mini", "gpt-4o"]
    },
    "aoai-west": {
      "kind": "azure-openai",
      "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-aoai/providers/Microsoft.CognitiveServices/accounts/aoai-west",
      "registerVia": "suggestion",
      "publish": ["o4-mini"]
    },
    "foundry-partners": {
      "kind": "foundry",
      "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-foundry/providers/Microsoft.CognitiveServices/accounts/foundry-partners",
      "projectResourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-foundry/providers/Microsoft.CognitiveServices/accounts/foundry-partners/projects/partners",
      "registerVia": "suggestion",
      "publish": ["grok-4.3", "Llama-3.3-70B-Instruct", "claude-haiku-4-5"],
      "notes": "Multi-provider target: xAI, Meta, and Anthropic deployments on one Foundry resource."
    }
  },
  "negatives": {
    "aoai-private": {
      "kind": "azure-openai",
      "resourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-private/providers/Microsoft.CognitiveServices/accounts/aoai-private",
      "reason": "Public network access is disabled, so the gateway cannot reach it."
    }
  },
  "suite": {
    "gateway": "contoso-apim",
    "runtime": {
      "userGrants": [
        { "endpoint": "aoai-east", "deployment": "gpt-4.1-mini" },
        { "endpoint": "foundry-partners", "deployment": "grok-4.3" }
      ],
      "applicationGrant": { "endpoint": "aoai-east", "deployment": "gpt-4.1-mini" },
      "foreignGrant": { "persona": "guest", "endpoint": "aoai-west", "deployment": "o4-mini" },
      "apiVersion": "2024-10-21",
      "modelsApiVersion": "2024-05-01-preview",
      "chatTokenParameter": "max_completion_tokens"
    },
    "disposable": {
      "publication": {
        "endpoint": "aoai-west",
        "deployment": "gpt-4.1-nano",
        "requester": "guest",
        "limits": { "tokensPerMinute": 1000, "calls": 10, "perSeconds": 60 }
      },
      "sharedBudget": { "persona": "user-a", "endpoint": "aoai-east", "deployment": "gpt-4o", "calls": 2, "perSeconds": 300 },
      "tokenLimit": { "persona": "user-a", "endpoint": "foundry-partners", "deployment": "Llama-3.3-70B-Instruct", "tokensPerMinute": 100 }
    }
  },
  "modelJourneys": {
    "ownerTag": "e2e-model-demo",
    "publicationId": "pub_fictional_model_proofs",
    "modelApiId": "api_fictional_model_proofs",
    "gatewayId": "gw_fictional_development",
    "price": {
      "actualModel": "fictional-chat-mini",
      "version": "2026-01-01",
      "deploymentType": "Standard",
      "region": "eastus",
      "date": "2026-01-01",
      "inputPerMillion": 0.5,
      "cachedInputPerMillion": 0.1,
      "outputPerMillion": 2,
      "evidenceReference": "fictional-price-review-NOT-LIVE"
    },
    "bounds": {
      "maxRequests": 80,
      "maxPromptTokens": 32000,
      "maxOutputTokens": 8,
      "maxUsd": 0.02,
      "intervalSeconds": 30,
      "timeoutSeconds": 1800
    },
    "selection": {
      "default": { "id": "ent_fictional_default", "persona": "user-a", "costCenterId": "cc_fictional_default", "code": "e2e-model-demo-default" },
      "other": { "id": "ent_fictional_control", "persona": "user-a", "costCenterId": "cc_fictional_control", "code": "e2e-model-demo-control" }
    },
    "pool": {
      "first": { "id": "ent_fictional_pool_a", "persona": "user-a", "costCenterId": "cc_fictional_pool", "code": "e2e-model-demo-pool" },
      "second": { "id": "ent_fictional_pool_b", "persona": "guest", "costCenterId": "cc_fictional_pool", "code": "e2e-model-demo-pool" },
      "monthlyTokens": 320
    },
    "budget": {
      "grant": { "id": "ent_fictional_budget", "persona": "user-a", "costCenterId": "cc_fictional_budget", "code": "e2e-model-demo-budget" },
      "amount": 0.01,
      "raisedAmount": 0.1,
      "managedGateways": [
        { "id": "gw_fictional_development", "tier": "classic" },
        { "id": "gw_fictional_staging", "tier": "classic" },
        { "id": "gw_fictional_production", "tier": "classic" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "m-tools": {
        "url": "https://m-tools-example.azurecontainerapps.io/mcp",
        "displayName": "M-tools",
        "upstreamAuth": "none",
        "tools": ["echo", "utc_now", "add"]
      },
      "m-protected": {
        "url": "https://m-protected-example.azurecontainerapps.io/mcp",
        "displayName": "M-protected",
        "upstreamAuth": "managed-identity",
        "audience": "api://00000000-0000-0000-0000-000000000000",
        "tools": ["echo", "utc_now", "add"]
      },
      "m-agent": {
        "url": "https://m-agent-example.azurecontainerapps.io/mcp",
        "displayName": "M-agent",
        "upstreamAuth": "none",
        "tools": ["ask_model"],
        "modelCaller": { "application": "mosaic-dev-mcp-agent", "modelGrant": "ent_00000000000000000000000000000009" },
        "notes": "Its tool calls a governed model as the application it names, passing on x-mosaic-on-behalf-of."
      }
    },
    "grants": {
      "tools-user": { "server": "m-tools", "persona": "user-a", "id": "ent_00000000000000000000000000000001", "costCenter": "general" },
      "protected-user": { "server": "m-protected", "persona": "user-a", "id": "ent_00000000000000000000000000000002", "costCenter": "general" },
      "tools-agent": { "server": "m-tools", "application": "mosaic-dev-mcp-agent", "id": "ent_00000000000000000000000000000003", "costCenter": "general" },
      "tools-limited": {
        "server": "m-tools",
        "persona": "user-a",
        "id": "ent_00000000000000000000000000000004",
        "costCenter": "e2e-limits",
        "callLimit": { "calls": 10, "perSeconds": 60 },
        "notes": "For --prove-call-limit: a fresh grant with no other callers."
      },
      "tools-pooled": {
        "server": "m-tools",
        "persona": "user-a",
        "id": "ent_00000000000000000000000000000005",
        "costCenter": "e2e-pool",
        "pooledCalls": 10,
        "notes": "For --prove-pooled-quota, which spends the cost center's pool on the server for the rest of the month."
      },
      "agent-user": { "server": "m-agent", "persona": "user-a", "id": "ent_00000000000000000000000000000006", "costCenter": "general" },
      "tools-revocable": {
        "server": "m-tools",
        "persona": "user-a",
        "id": "ent_00000000000000000000000000000007",
        "costCenter": "e2e-revoke",
        "notes": "For --watch-revocation: revoked, and its server's plan applied, during the run."
      }
    },
    "missingScopeClientId": "33333333-3333-3333-3333-333333333333"
  }
}
