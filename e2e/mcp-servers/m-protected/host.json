{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.38.1, 4.39.0)"
  },
  "extensions": {
    "mcp": {
      "serverName": "M-protected",
      "serverVersion": "1.0.0",
      "instructions": "Deterministic tools for MOSAIC's end-to-end tests.",
      "system": {
        "webhookAuthorizationLevel": "Anonymous"
      }
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function.echo.User": "Information",
      "Function.utc_now.User": "Information",
      "Function.add.User": "Information"
    }
  }
}
