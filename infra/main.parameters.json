{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "apimPublisherName": {
      "value": "${MOSAIC_APIM_PUBLISHER_NAME}"
    },
    "apimPublisherEmail": {
      "value": "${MOSAIC_APIM_PUBLISHER_EMAIL}"
    },
    "tenantId": {
      "value": "${MOSAIC_TENANT_ID}"
    },
    "apiAppClientId": {
      "value": "${MOSAIC_API_CLIENT_ID}"
    },
    "modelRuntimeClientId": {
      "value": "${MOSAIC_MODEL_RUNTIME_CLIENT_ID}"
    },
    "modelClientId": {
      "value": "${MOSAIC_MODEL_CLIENT_ID}"
    },
    "entraGroupClaims": {
      "value": "${MOSAIC_ENTRA_GROUP_CLAIMS=true}"
    },
    "apiServicePrincipalObjectId": {
      "value": "${MOSAIC_API_SERVICE_PRINCIPAL_OBJECT_ID}"
    },
    "spaAppClientId": {
      "value": "${MOSAIC_SPA_CLIENT_ID}"
    },
    "portalAppClientId": {
      "value": "${MOSAIC_PORTAL_CLIENT_ID}"
    },
    "apiApplicationIdUri": {
      "value": "${MOSAIC_API_APPLICATION_ID_URI}"
    },
    "apiScope": {
      "value": "${MOSAIC_API_SCOPE}"
    },
    "teamsWorkflowAllowedHosts": {
      "value": "${MOSAIC_TEAMS_WORKFLOW_ALLOWED_HOSTS=[]}"
    },
    "teamsBotAuthMode": {
      "value": "${MOSAIC_TEAMS_BOT_AUTH_MODE=disabled}"
    },
    "teamsBotAppId": {
      "value": "${MOSAIC_TEAMS_BOT_APP_ID=}"
    },
    "teamsBotSecretReference": {
      "value": "${MOSAIC_TEAMS_BOT_SECRET_REFERENCE=}"
    },
    "teamsBotManagedIdentityResourceId": {
      "value": "${MOSAIC_TEAMS_BOT_MANAGED_IDENTITY_RESOURCE_ID=}"
    }
  }
}
