{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "apimPublisherName": {
      "value": "${MOSAIC_APIM_PUBLISHER_NAME}"
    },
    "apimPublisherEmail": {
      "value": "${MOSAIC_APIM_PUBLISHER_EMAIL}"
    },
    "tenantId": {
      "value": "${MOSAIC_TENANT_ID}"
    },
    "apiAppClientId": {
      "value": "${MOSAIC_API_CLIENT_ID}"
    },
    "modelRuntimeClientId": {
      "value": "${MOSAIC_MODEL_RUNTIME_CLIENT_ID}"
    },
    "modelClientId": {
      "value": "${MOSAIC_MODEL_CLIENT_ID}"
    },
    "entraDirectoryLookup": {
      "value": "${MOSAIC_ENTRA_DIRECTORY_LOOKUP=true}"
    },
    "entraGroupClaims": {
      "value": "${MOSAIC_ENTRA_GROUP_CLAIMS=true}"
    },
    "apiServicePrincipalObjectId": {
      "value": "${MOSAIC_API_SERVICE_PRINCIPAL_OBJECT_ID}"
    },
    "spaAppClientId": {
      "value": "${MOSAIC_SPA_CLIENT_ID}"
    },
    "portalAppClientId": {
      "value": "${MOSAIC_PORTAL_CLIENT_ID}"
    },
    "apiApplicationIdUri": {
      "value": "${MOSAIC_API_APPLICATION_ID_URI}"
    },
    "apiScope": {
      "value": "${MOSAIC_API_SCOPE}"
    },
    "deployEmail": {
      "value": "${MOSAIC_DEPLOY_EMAIL=false}"
    },
    "emailDataLocation": {
      "value": "${MOSAIC_EMAIL_DATA_LOCATION=United States}"
    }
  }
}
